# Copy this file to ".env" and fill in your own values.
# The real ".env" is in .gitignore and must NEVER be pushed to GitHub.
# NOTE: the variable names must match the ones used in server/config/db.js.

PORT=5000

# Oracle Database (the assignment's MONGO_URI is replaced by these)
DB_USER=
DB_PASSWORD=
# Format: host:port/service_name  (example: localhost:1521/XEPDB1)
DB_CONNECT_STRING=

# Secret used to sign JWT tokens (use a long random string)
JWT_SECRET=
